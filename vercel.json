{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/grupo1",
      "destination": "https://chat.whatsapp.com/LM8f9kK63OE0e71aawXUJU",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/pasarela", "destination": "/pasarela.html" },
    { "source": "/pasarela/checkout", "destination": "/pasarela-checkout.html" },
    { "source": "/curso", "destination": "/curso.html" },
    { "source": "/panel", "destination": "/panel.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/gracias", "destination": "/gracias.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}